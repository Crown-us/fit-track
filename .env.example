# Copy to .env and fill in. Never commit the real file.

# Required. At least 32 bytes. Generate one with: openssl rand -base64 48
JWT_SECRET=

# Optional settings with their defaults.
HTTP_ADDR=:8080
DATABASE_PATH=fittrack.db
JWT_TTL=24h
BCRYPT_COST=10
LOG_LEVEL=info
# Timezone that decides when a day starts (IANA name).
APP_TIMEZONE=Asia/Jakarta
# Register and login attempts allowed per client address per window.
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW=1m
# Set to true only behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY_HEADERS=false
